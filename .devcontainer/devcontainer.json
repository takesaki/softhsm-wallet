{
  "name": "softhsm-ether",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/shyim/devcontainers-features/bun:0": {}
  },
  "containerEnv": {
    "SOFTHSM2_CONF": "${containerWorkspaceFolder}/softhsm2.conf"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "biomejs.biome"
      ]
    }
  }
}
